#version 450
#extension GL_GOOGLE_include_directive : require
// Carrier atlas: per texel of the current coastal field, what the surf band reads from the layer B maps, interpolated to
// the carrier's reference once here: the lag, water depth, shoal amplitude and active flag. Rebuilt only when the field
// or the carrier's wavenumber changes (OceanRenderer.Prepare, RecordCompute). One thread per texel.

#define CARRIER_ATLAS_WRITABLE
#include "ocean_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

// Reference j of the texel whose first vec4 is t, in buffer s: (lag, amp).
vec2 refOf(int s, int t, int j)
{
    vec4 q = coastal[s].texels[t + 1 + j / 2];
    return (j & 1) != 0 ? q.zw : q.xy;
}

void main()
{
    int s = frame.counts.w & 7;
    int res = int(frame.coastRect.w);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (res <= 0 || p.x >= res || p.y >= res)
        return;

    // The carrier's lag and shoal amplitude: its two references mixed by the carrier's reference coordinate.
    int t = (p.x + p.y * res) * TEXEL_VEC4S;
    int jc = int(frame.carrier.y);
    vec2 c = mix(refOf(s, t, jc), refOf(s, t, jc + 1), frame.carrier.y - float(jc));
    vec4 head = coastal[s].texels[t];
    imageStore(carrierAtlas, ivec3(p, 0), vec4(c.x, head.x, c.y, head.y));
}
