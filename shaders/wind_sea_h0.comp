#version 450

// Wind sea bands for voxel water (docs/voxel-water.md "Wind on voxel water", WindSeaBands): per band, a random wave
// field of unit mean square slope over one octave of wavenumber, spread about the wind. Two bands share a layer and its
// patch, the longer at texel radius 8..16 and the shorter at 16..32, so voxel water reads both with one fetch; each
// layer's patch is a quarter of the last's. The water weights the bands per vertex by the spectrum its own wind and
// fetch raise, so a lake shows its own peak wavelength. Per texel: h0 at k and at -k, and omega quantised to the loop.
// Rebuilt only when the wind's direction or spread changes.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform Bands {
    vec4 wind;   // x = direction rad (waves travel toward), y = spread exponent s, z = spread norm Ns, w = looped time t
    vec4 params; // x = loop period T
} bands;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2DArray h0Map;  // (h0(k).re, h0(k).im, h0(-k).re, h0(-k).im)
layout(set = 0, binding = 2, r32f) writeonly uniform image2DArray omegaMap;  // omega, quantised to multiples of 2pi/T

const int N = 128;
const int BANDS = 10;
const float LAYER_PATCH = 128.0;  // m, layer 0's patch; each layer's is a quarter of the last's (wind_sea.glsl)
const float PI = 3.14159265358979;
const float TAU = 6.28318530717959;
const float G = 9.81;
const float SURFACE_TENSION = 7.4e-5; // sigma / rho (m^3/s^2): ripples under ~2 cm run faster than gravity waves
const float LN2 = 0.69314718056;

uvec4 pcg4d(uvec4 v)
{
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
    v ^= v >> 16u;
    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
    return v;
}

vec2 gaussian2(uvec2 texel, uint band)
{
    uvec4 h = pcg4d(uvec4(texel, band, 0x5eed1u));
    float u1 = (float(h.x >> 8u) + 1.0) * (1.0 / 16777216.0);
    float u2 = float(h.y >> 8u) * (1.0 / 16777216.0);
    float r = sqrt(-2.0 * log(u1));
    float a = TAU * u2;
    return vec2(r * cos(a), r * sin(a));
}

float spreading(float theta)
{
    float d = theta - bands.wind.x;
    d -= TAU * round(d / TAU);
    return bands.wind.z * pow(abs(cos(0.5 * d)), 2.0 * bands.wind.y);
}

// A saturated band: slope variance B per unit ln k with B = 1 / ln 2, so the octave's mean square slope is 1. As a
// wavenumber spectrum per unit area, B k^-4 D(theta). E|h(k)|^2 = 2 E|h0|^2 = 4 amp^2 (h0 and conj h0(-k) both carry
// it), so amp^2 = Phi dk^2 / 4.
vec2 h0At(uvec2 texel, uint band, float L)
{
    float dk = TAU / L;
    vec2 k = (vec2(texel) - 0.5 * float(N)) * dk;
    float r = length(vec2(texel) - 0.5 * float(N));
    float lo = (band & 1u) == 0u ? 8.0 : 16.0;
    if (r < lo || r >= 2.0 * lo)
        return vec2(0.0);

    float kLen = length(k);
    float phi = spreading(atan(k.y, k.x)) / (LN2 * kLen * kLen * kLen * kLen);
    return gaussian2(texel, band) * sqrt(phi * dk * dk * 0.25);
}

void main()
{
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= uint(N) || id.y >= uint(N) || id.z >= uint(BANDS))
        return;

    ivec3 coord = ivec3(id);
    float L = LAYER_PATCH / float(1 << (2u * (id.z >> 1u)));
    uvec2 mirror = (uvec2(N) - id.xy) % uvec2(N);
    vec2 h0 = h0At(id.xy, id.z, L);
    vec2 h0m = h0At(mirror, id.z, L);

    float k = length(vec2(id.xy) - 0.5 * float(N)) * TAU / L;
    float w = sqrt(G * k + SURFACE_TENSION * k * k * k);
    float w0 = TAU / bands.params.x;
    w = max(round(w / w0), 1.0) * w0;

    imageStore(h0Map, coord, vec4(h0, h0m));
    imageStore(omegaMap, coord, vec4(w));
}
