#version 450
#extension GL_GOOGLE_include_directive : require
// Spray spawn (docs/breaking-waves.md, rendering step 6): one invocation per breaker segment. Segments whose lip is
// throwing (high curl) emit particles, at a rate set by curl x crest length x wave height: most where the lip lands,
// thrown shoreward and up, the rest feathering off the lip's thin edge as it throws. Slots come from an atomic ring
// head, so the oldest particles are overwritten.

#define SPRAY_WRITABLE
#include "ocean_common.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform Push {
    vec4 params; // x = frame seconds, y = random seed, z = segment count
} pc;

const float SPRAY_RATE = 14.0;   // particles per second per metre of crest per metre of wave height at full plunge
const float SPRAY_MIN_HEIGHT = 0.8; // a small wave's crash sprays as if this tall: at its own height it hardly showed
const float FEATHER_SHARE = 0.35; // share of them leaving the lip's edge rather than its landing
const int MAX_PER_SEGMENT = 16;  // per frame

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.params.z))
        return;

    // The crest's surf state at the segment's two lip bases (ocean_lip_base.comp; an end under the lip thresholds holds no lip).
    BreakerSegment s = breakers.segments[id];
    LipBase e0 = lipBaseAt(s, 0);
    LipBase e1 = lipBaseAt(s, 1);
    if (lipBaseEmpty(e0) || lipBaseEmpty(e1))
        return;

    vec4 surf = 0.5 * (e0.state + e1.state);
    float curl = surf.x;
    float height = surf.z;
    float throwing = smoothstep(0.6, 0.95, curl);
    if (throwing <= 0.0 || height < 0.1 || !lipInRange(s))
        return;

    float dt = pc.params.x;
    float crest = distance(s.ends.xy, s.ends.zw);
    float expected = SPRAY_RATE * throwing * crest * max(height, SPRAY_MIN_HEIGHT) * dt;
    uint state = hash(id * 9781u ^ floatBitsToUint(pc.params.y));
    int count = min(int(expected) + (random(state) < fract(expected) ? 1 : 0), MAX_PER_SEGMENT);
    if (count <= 0)
        return;

    uint first = atomicAdd(spray.head, uint(count));
    vec2 n = s.dir.xy;
    vec3 forward = vec3(n.x, 0.0, n.y);
    vec3 side = vec3(-n.y, 0.0, n.x);
    float celerity = s.dir.z;

    // The drawn surface at the crest and the tongue's landing, between the segment's two lip bases (ocean_lip_base.comp,
    // written for a throwing segment), rather than a full surface evaluation per particle. Spray leaves the tip while
    // the tongue is still reaching, and the landing once it has got there.
    float reach = 0.5 * (e0.landing.w + e1.landing.w);
    float plunge = 0.5 * (e0.normal.w + e1.normal.w);
    if (reach <= 0.0)
        return;

    for (int k = 0; k < count; ++k)
    {
        float r = random(state);
        vec4 base = mix(e0.position, e1.position, r);
        vec4 landing = mix(e0.landing, e1.landing, r);
        float throwDist = mix(e0.surface.x, e1.surface.x, r);
        if (base.w > 0.5)
            continue;

        SprayParticle particle;
        particle.motion = SPRAY_MOTION;
        if (reach < 1.0 || random(state) < FEATHER_SHARE)
        {
            // Off the thin edge of the tongue as it throws: fine, short-lived, carried on with the lip and a little up.
            float drop = max(base.y - landing.y, 0.02 * height);
            vec4 c = lipPath(reach * (0.85 + 0.15 * random(state)), throwDist, drop, plunge);
            vec3 p = base.xyz + forward * c.x + vec3(0.0, c.y, 0.0);
            vec3 v = forward * celerity * (0.6 + 0.4 * random(state))
                   + vec3(0.0, (0.3 + 1.2 * random(state)) * sqrt(max(height, 0.2)), 0.0)
                   + side * (random(state) - 0.5);
            particle.positionLife = vec4(p, 0.4 + 0.6 * random(state));
            particle.velocitySize = vec4(v, 0.12 + 0.2 * random(state));
        }
        else
        {
            vec3 v = forward * celerity * (0.3 + 0.5 * random(state))
                   + vec3(0.0, (1.5 + 3.0 * random(state)) * sqrt(max(height, 0.2)), 0.0)
                   + side * (random(state) - 0.5) * 1.5;
            particle.positionLife = vec4(landing.xyz, 0.8 + 1.4 * random(state));
            particle.velocitySize = vec4(v, 0.3 + 0.4 * random(state));
        }

        spray.particles[(first + uint(k)) % SPRAY_MAX] = particle;
    }
}
