#version 450
#extension GL_GOOGLE_include_directive : require
// Splash spray: one invocation per splash (ZoneFlowSim.Agitate), where sea-zone water slammed into something this tick.
// Slots come from the breaker spray's atomic ring head.
// - Wall: water running into a wall it can only climb. Droplets leave along the metre of wall just off its face, thrown
//   up it and back over the water, at a rate and speed set by how fast the water arrives.
// - Pour: water landing from a fall, a waterfall's foot. A crown of droplets thrown up and out around where it lands,
//   and a cloud of mist that hangs over the plunge pool, both as many as the pour is heavy and fast.

#define SPRAY_WRITABLE
#include "ocean_common.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform Push {
    vec4 params; // x = frame seconds, y = random seed, z = splash count
} pc;

const float WALL_RATE = 30.0;     // particles per second per metre of wall per m/s into it past WALL_THRESHOLD
const float WALL_THRESHOLD = 0.4; // m/s: slower water only laps at the wall
const float WALL_LIFT = 3.0;      // upward launch speed per m/s into the wall: the jet runs up far faster than the flow
const float WALL_BACK = 0.6;      // ... and back off the wall over the water
const float POUR_RATE = 10.0;     // particles per second per metre of lip, per m²/s of discharge, per m/s of fall
const float POUR_MIST = 0.25;     // share of a pour's particles that are mist
const int MAX_PER_SPLASH = 4;     // per frame

void wall(WaterSplash w, inout uint state, uint slot)
{
    float speed = w.positionSpeed.w;
    vec3 into = vec3(w.direction.x, 0.0, w.direction.y);
    vec3 along = vec3(-into.z, 0.0, into.x);
    float body = min(w.direction.z, 1.0);

    vec3 p = w.positionSpeed.xyz + along * (random(state) - 0.5) - into * (0.1 + 0.2 * random(state));
    vec3 v = vec3(0.0, WALL_LIFT * speed * (0.5 + 0.7 * random(state)), 0.0)
           - into * (WALL_BACK * speed * random(state))
           + along * ((random(state) - 0.5) * speed);

    SprayParticle particle;
    particle.positionLife = vec4(p, 0.5 + 0.8 * random(state));
    particle.velocitySize = vec4(v, (0.06 + 0.14 * random(state)) * (0.5 + 0.5 * body));
    particle.motion = SPRAY_MOTION;
    spray.particles[slot % SPRAY_MAX] = particle;
}

void pour(WaterSplash w, inout uint state, uint slot)
{
    float speed = w.positionSpeed.w;
    vec3 flow = vec3(w.direction.x, 0.0, w.direction.y);
    float angle = TWO_PI * random(state);
    vec3 outward = vec3(cos(angle), 0.0, sin(angle));
    vec3 p = w.positionSpeed.xyz + outward * (0.6 * random(state)) + flow * (0.5 * random(state));

    SprayParticle particle;
    if (random(state) < POUR_MIST)
    {
        p.y += 0.2 + 0.6 * random(state);
        vec3 v = vec3(0.0, 0.5 + 1.0 * random(state), 0.0) + outward * (0.3 + 0.7 * random(state)) + flow * 0.5;
        particle.positionLife = vec4(p, 1.5 + 2.0 * random(state));
        particle.velocitySize = vec4(v, 0.15 + 0.15 * random(state));
        particle.motion = MIST_MOTION;
    }
    else
    {
        vec3 v = vec3(0.0, speed * (0.3 + 0.5 * random(state)), 0.0) + outward * (speed * (0.2 + 0.4 * random(state))) + flow * (0.3 * speed);
        particle.positionLife = vec4(p, 0.5 + 0.7 * random(state));
        particle.velocitySize = vec4(v, 0.06 + 0.12 * random(state));
        particle.motion = SPRAY_MOTION;
    }

    spray.particles[slot % SPRAY_MAX] = particle;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.params.z))
        return;

    WaterSplash w = waterSplashes.items[id];
    float speed = w.positionSpeed.w;
    bool isPour = w.direction.w == SPLASH_POUR;
    float rate = isPour ? POUR_RATE * w.direction.z * speed : WALL_RATE * max(speed - WALL_THRESHOLD, 0.0);
    float expected = rate * pc.params.x;
    uint state = hash(id * 7919u ^ floatBitsToUint(pc.params.y));
    int count = min(int(expected) + (random(state) < fract(expected) ? 1 : 0), MAX_PER_SPLASH);
    if (count <= 0)
        return;

    uint first = atomicAdd(spray.head, uint(count));
    for (int k = 0; k < count; ++k)
    {
        if (isPour)
            pour(w, state, first + uint(k));
        else
            wall(w, state, first + uint(k));
    }
}
