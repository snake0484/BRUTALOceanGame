<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BrutalGame</RootNamespace>
    <AssemblyName>BRUTALGame</AssemblyName>
  </PropertyGroup>
  <!--
    Opt-in ReadyToRun: precompiles the game and BRUTAL assemblies so start-up runs optimised code instead of tier-0 JIT.
    Hot methods still re-JIT at tier 1 with TieredPGO. Output: bin/Release/net10.0/win-x64/publish/
    dotnet publish src/Game/Game.csproj -c Release -p:BrutalReadyToRun=true
  -->
  <PropertyGroup Condition="'$(BrutalReadyToRun)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\shaders\**\*" LinkBase="shaders" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <ProjectReference Include="..\Debug\Debug.csproj" />
    <ProjectReference Include="..\Sim\Sim.csproj" />
    <ProjectReference Include="..\Water.Rendering\Water.Rendering.csproj" />
    <ProjectReference Include="..\Terrain.Runtime\Terrain.Runtime.csproj" />
    <ProjectReference Include="..\Weather\Weather.csproj" />
  </ItemGroup>
</Project>
