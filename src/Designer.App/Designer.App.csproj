<Project>
  <!--
    Authoring (planet tabs, D89): our own tools, never in the app players get. Off unless asked for, in every
    configuration, so the solution build is the shipping graph and writes the restore DesignerBoundaryTests reads
    (obj/project.assets.json). runDesigner.bat and scripts/check-authoring.ps1 build with -p:Authoring=true; an
    authoring build adds the game-view references and keeps its own obj and bin (obj/authoring, bin/authoring).
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Authoring Condition="'$(Authoring)' == ''">false</Authoring>
    <BaseIntermediateOutputPath Condition="'$(Authoring)' == 'true'">obj\authoring\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(Authoring)' == 'true'">bin\authoring\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BrutalGame.Designer.App</RootNamespace>
    <AssemblyName>BRUTALDesigner</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Authoring)' == 'true'">
    <DefineConstants>$(DefineConstants);AUTHORING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\shaders\**\*" LinkBase="shaders" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\**\*" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Designer.Ui\Designer.Ui.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Authoring)' == 'true'">
    <ProjectReference Include="..\Game\Game.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Authoring)' != 'true'">
    <Compile Remove="Authoring\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
    <None Remove="obj\**;bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BrutalGame.DesignKit.Ui" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
